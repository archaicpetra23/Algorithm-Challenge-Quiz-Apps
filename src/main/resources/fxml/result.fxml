<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.algorithmquiz.controller.ResultController"
      styleClass="root-bg" prefWidth="960" prefHeight="680" alignment="CENTER">

    <VBox styleClass="result-card" maxWidth="520" alignment="CENTER" spacing="20">

        <!-- Trophy icon -->
        <FontIcon iconLiteral="fas-trophy" iconSize="60" styleClass="result-trophy-icon"/>

        <!-- Player name -->
        <Label fx:id="lblPlayerName" styleClass="result-player" text="Halo, Pemain!"/>

        <!-- Level badge -->
        <Label fx:id="lblLevel" styleClass="badge-easy" text="EASY"/>

        <!-- Score -->
        <VBox alignment="CENTER" spacing="4">
            <Label styleClass="result-score-label" text="Total Skor"/>
            <Label fx:id="lblScore" styleClass="result-score" text="0"/>
        </VBox>

        <!-- Grade & message -->
        <Label fx:id="lblGrade" styleClass="result-grade" text="A"/>
        <Label fx:id="lblMessage" styleClass="result-message" text=""/>

        <!-- Stats -->
        <HBox styleClass="result-stats" alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="4">
                <HBox alignment="CENTER" spacing="6">
                    <FontIcon iconLiteral="fas-check-circle" iconSize="20" styleClass="icon-success"/>
                    <Label styleClass="stat-correct" fx:id="lblCorrect" text="0"/>
                </HBox>
                <Label styleClass="stat-sublabel" text="Jawaban Benar"/>
            </VBox>
            <Separator orientation="VERTICAL"/>
            <VBox alignment="CENTER" spacing="4">
                <HBox alignment="CENTER" spacing="6">
                    <FontIcon iconLiteral="fas-times-circle" iconSize="20" styleClass="icon-error"/>
                    <Label styleClass="stat-wrong" fx:id="lblWrong" text="0"/>
                </HBox>
                <Label styleClass="stat-sublabel" text="Jawaban Salah"/>
            </VBox>
        </HBox>

        <!-- Saved status -->
        <Label fx:id="lblSavedStatus" styleClass="saved-status" text="" wrapText="true"/>

        <!-- Action buttons -->
        <VBox spacing="10" maxWidth="Infinity">
            <Button styleClass="btn-primary-lg" maxWidth="Infinity" onAction="#onRetry">
                <graphic><FontIcon iconLiteral="fas-redo" iconSize="14"/></graphic>
                <text>Coba Lagi</text>
            </Button>
            <Button styleClass="btn-secondary-lg" maxWidth="Infinity" onAction="#onLeaderboard">
                <graphic><FontIcon iconLiteral="fas-trophy" iconSize="14"/></graphic>
                <text>Lihat Leaderboard</text>
            </Button>
            <Button styleClass="btn-ghost-lg" maxWidth="Infinity" onAction="#onMainMenu">
                <graphic><FontIcon iconLiteral="fas-home" iconSize="14"/></graphic>
                <text>Main Menu</text>
            </Button>
        </VBox>
    </VBox>
</VBox>
